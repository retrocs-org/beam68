; $VER: Install-Beam68 0.1 (27.10.2026)
;
; Beam68 GUI installer for the AmigaOS "Installer" utility (Installer 42.x
; ships with AmigaOS 3.1+; Installer 43.3 for older systems is on Aminet).
; Double-click "Install" on Workbench.  It installs, updates or uninstalls
; Beam68, Beam68Prefs, the bundled plugins and the Workbench startup entry.
;
; Settings in ENVARC:Beam68 are never overwritten by an update.  The chosen
; drawer is remembered in ENVARC:Beam68/InstallDir for later updates and
; uninstallation.  The Shell installer scripts/Install-Beam68 remains for
; scripted installs.

(set @app-name "Beam68")
(set #version "0.1")
(set #default-parent "SYS:Utilities")
(set #default-dest "SYS:Utilities/Beam68")
(set #startup "SYS:WBStartup/Beam68Start")
(set #plugin-count 13)
(set #plugin-mask 8191)
(set #pluginlines "")
(set #ctl "Beam68Ctl")

; ------------------------------------------------------------- texts
