(set #t_keep "Keep settings")
(set #t_delete "Delete settings")
(set #t_removed "Beam68 has been removed.")
(set #t_welcome "Welcome to the Beam68 installer.")
(set #t_not_installed "Beam68 is not installed.\n\nWhat would you like to do?")
(set #t_installed_in "Beam68 is installed in\n")
(set #t_what_do "\n\nWhat would you like to do?")
(set #t_help_main "Install or update: copies Beam68, Beam68Prefs and the chosen plugins.\nYour settings are kept.\n\nUninstall: removes Beam68 and, if you wish, its settings.\n\n")
(set #t_choice_install "Install or update Beam68")
(set #t_choice_uninstall "Uninstall Beam68")
