; ---------------------------------------------------------------- helpers

; Plugin drawer name for index #i.  Same order as the askoptions list.
(procedure P_PLUGIN_NAME
  (set #plugin
    (select #i "Calc" "Clock" "Memory" "FileFinder" "SystemCommands"
               "DosTools" "TaskManager" "ClipboardTools" "DateUtilities"
               "WindowSwitcher" "DeveloperTools" "ARexxRunner"
               "MusicControls"))
)

; Ask a running launcher to quit and wait until it has gone: QUITWAIT
; returns 0 when Beam68 is stopped (or was not running) and 10 when it is
; still running after 15 seconds, e.g. because a requester is open.
(procedure P_STOP_LAUNCHER
  (if (= (exists #ctl (noreq)) 1)
    (
      (working #t_stopping)
      ; AmigaDOS redirection must follow the command name directly.
      (if (<> (run (cat "\"" #ctl "\" >NIL: QUITWAIT")) 0)
        (abort #t_still_running)
      )
    )
  )
)

(procedure P_MAKEDIR
  (if (= (exists #dir (noreq)) 0)
    (makedir #dir (prompt (cat #t_creating #dir)) (help @makedir-help))
  )
)

; Copy #src into drawer #to.
(procedure P_COPY
  (copyfiles
    (prompt (cat #t_copying #src))
    (help @copyfiles-help)
    (source #src)
    (dest #to)
    (nogauge)
  )
)

; Copy the icon of #src, but keep an existing one (position, tool types).
(procedure P_COPY_ICON
  (if (= (exists (tackon #to (cat (fileonly #src) ".info")) (noreq)) 0)
    (copyfiles
      (prompt (cat #t_copying_icon #src))
      (help @copyfiles-help)
      (source (cat #src ".info"))
      (dest #to)
      (nogauge)
    )
  )
)

(procedure P_DELETE_FILE
  (if (= (exists #file (noreq)) 1)
    (delete #file (optional "force"))
  )
)

; Updates keep the user's configuration file #cfg, but add a PLUGIN= line
; for every chosen plugin it does not mention yet, and record a non-default
; install drawer.  C:Search returns 5 (WARN) when the text is absent.
(procedure P_UPDATE_CONFIG
  (set #i 0)
  (while (< #i #plugin-count)
    (P_PLUGIN_NAME)
    (if (IN #plugins #i)
      (if (= (run (cat "C:Search FROM \"" #cfg "\" SEARCH \"" #plugin ".plugin\" QUIET")) 5)
        (run (cat "Echo >>\"" #cfg "\" \"PLUGIN=PROGDIR:Plugins/" #plugin "/" #plugin ".plugin\""))
      )
    )
    (set #i (+ #i 1))
  )
  (if (<> #dest #default-dest)
    (if (= (run (cat "C:Search FROM \"" #cfg "\" SEARCH \"INSTALL_DIR=" #dest "\" QUIET")) 5)
      (run (cat "Echo >>\"" #cfg "\" \"INSTALL_DIR=" #dest "\""))
    )
  )
)

; ---------------------------------------------------------- install/update

(procedure P_INSTALL
  (if (< (/ (getversion "exec.library" (resident)) 65536) 39)
    (abort #t_needs_os)
  )
  (if (<> (exists "Beam68" (noreq)) 1)
    (abort #t_no_binary)
  )

  (set #parent (if (= #existing "") #default-parent (pathonly #existing)))
  (set #parent
    (askdir
      (prompt #t_ask_dir)
      (help #t_help_dir @askdir-help)
      (default #parent)
    )
  )
  (set #dest (tackon #parent "Beam68"))
  (set @default-dest #dest)
  (set #update (= (exists (tackon #dest "Beam68") (noreq)) 1))

  (set #plugins
    (askoptions
      (prompt (if #update
        #t_ask_plugins_update
        #t_ask_plugins_new))
      (help #t_help_plugins @askoptions-help)
      (choices
        "Calculator             =  (integer maths)"
        "Clock                  @  (date and time)"
        "Memory                 ?  (free memory)"
        "File Finder            /  find:"
        "System Commands        !  system:"
        "Assigns and Volumes    #  dos:"
        "Task Manager           ^  task:"
        "Clipboard Tools        &  clip:"
        "Date Utilities         :  date:"
        "Workbench Windows      ~  window:"
        "Developer Tools        $  dev:"
        "ARexx Runner           %  rexx:"
        "Music Controls         |  music:")
      (default #plugin-mask)
    )
  )

  (set #autostart
    (askbool
      (prompt #t_ask_autostart)
      (help #t_help_autostart @askbool-help)
      (default (if #update (exists #startup (noreq)) 1))
      (choices #t_yes #t_no)
    )
  )

  (P_STOP_LAUNCHER)
  (complete 10)

  ; -- program drawer and main files
  (if (= (exists #dest (noreq)) 0)
    (makedir #dest (prompt (cat #t_creating #dest)) (help @makedir-help) (infos))
  )
  (set #to #dest)
  (set #src "Beam68") (P_COPY) (P_COPY_ICON)
  (set #src "Beam68Ctl") (P_COPY)
  (set #src "Aliases.txt") (P_COPY)
  (set #src "Beam68.cfg") (P_COPY)
  (set #src "Beam68.guide") (P_COPY) (P_COPY_ICON)
  (set #dir (tackon #dest "scripts")) (P_MAKEDIR)
  (set #to #dir)
  (set #src "scripts/Beam68Status.rexx") (P_COPY)
  (set #to "SYS:Prefs")
  (set #src "Beam68Prefs") (P_COPY) (P_COPY_ICON)
  ; Theme gallery: Appearance -> Theme file -> Import
  (set #dir (tackon #dest "Themes")) (P_MAKEDIR)
  (copyfiles (prompt "Copying themes") (help @copyfiles-help)
             (source "themes") (dest #dir) (pattern "#?.theme") (nogauge))
  ; Translations: PROGDIR:Catalogs/<language>/Beam68.catalog
  (set #dir (tackon #dest "Catalogs")) (P_MAKEDIR)
  (set #lang 0)
  (while (< #lang 2)
    (set #language (select #lang "deutsch" "svenska"))
    (set #dir (tackon #dest (cat "Catalogs/" #language))) (P_MAKEDIR)
    (set #to #dir)
    (set #src (cat "catalogs/" #language "/Beam68.catalog")) (P_COPY)
    ; Beam68Prefs lives in SYS:Prefs, so its catalog goes to LOCALE:.
    (set #dir (cat "LOCALE:Catalogs/" #language)) (P_MAKEDIR)
    (set #to #dir)
    (set #src (cat "catalogs/" #language "/Beam68Prefs.catalog")) (P_COPY)
    (set #src (cat "catalogs/" #language "/Beam68Plugins.catalog")) (P_COPY)
    (set #lang (+ #lang 1))
  )
  (complete 35)

  ; -- settings drawers
  (set #dir "ENVARC:Beam68") (P_MAKEDIR)
  (set #dir "ENVARC:Beam68/Plugins") (P_MAKEDIR)
  (set #dir "ENV:Beam68") (P_MAKEDIR)

  ; -- plugins: one drawer per package
  (set #dir (tackon #dest "Plugins")) (P_MAKEDIR)
  (set #i 0)
  (while (< #i #plugin-count)
    (P_PLUGIN_NAME)
    (set #pdir (tackon #dest (cat "Plugins/" #plugin)))
    ; The 0.1 flat layout kept Plugins/<Name> as the program file itself;
    ; the package drawer of the same name replaces it.
    (if (= (exists (cat #pdir ".plugin") (noreq)) 1)
      (
        (set #file (cat #pdir ".plugin")) (P_DELETE_FILE)
        (set #file #pdir) (P_DELETE_FILE)
      )
    )
    (if (IN #plugins #i)
      (
        (working (cat #t_installing_plugin #plugin))
        (set #dir #pdir) (P_MAKEDIR)
        (set #to #pdir)
        (set #src (cat "Plugins/" #plugin "/" #plugin)) (P_COPY)
        (set #src (cat "Plugins/" #plugin "/" #plugin ".plugin")) (P_COPY)
        ; Default settings only when the user has none yet.
        (if (= (exists (cat "Plugins/" #plugin "/" #plugin ".cfg") (noreq)) 1)
          (if (= (exists (cat "ENVARC:Beam68/Plugins/" #plugin ".cfg") (noreq)) 0)
            (
              (set #to "ENVARC:Beam68/Plugins")
              (set #src (cat "Plugins/" #plugin "/" #plugin ".cfg")) (P_COPY)
            )
          )
        )
        (set #pluginlines
          (cat #pluginlines "PLUGIN=PROGDIR:Plugins/" #plugin "/" #plugin ".plugin\n"))
      )
    )
    (set #i (+ #i 1))
  )
  (complete 70)

  ; -- configuration: written once, afterwards only extended
  (if (= (exists "ENVARC:Beam68/Beam68.cfg" (noreq)) 0)
    (
      (set #cfgextra "")
      (if (<> #dest #default-dest)
        (set #cfgextra (cat "INSTALL_DIR=" #dest "\n"))
      )
      (textfile
        (prompt #t_writing_settings)
        (help @textfile-help)
        (dest "ENVARC:Beam68/Beam68.cfg")
        (include "installer/Beam68-base.cfg")
        (append #cfgextra)
        (append #pluginlines)
      )
    )
    (
      (set #cfg "ENVARC:Beam68/Beam68.cfg")
      (P_UPDATE_CONFIG)
    )
  )
  ; ENV: may hold settings applied with "Use" but not saved: extend them
  ; the same way instead of replacing them.
  (if (= (exists "ENV:Beam68/Beam68.cfg" (noreq)) 1)
    (
      (set #cfg "ENV:Beam68/Beam68.cfg")
      (P_UPDATE_CONFIG)
    )
    (
      (set #to "ENV:Beam68")
      (set #src "ENVARC:Beam68/Beam68.cfg") (P_COPY)
    )
  )
  (if (= (exists "ENVARC:Beam68/Snippets.txt" (noreq)) 0)
    ((set #to "ENVARC:Beam68") (set #src "Snippets.txt") (P_COPY))
  )
  (if (= (exists "ENVARC:Beam68/Aliases.txt" (noreq)) 0)
    ((set #to "ENVARC:Beam68") (set #src "Aliases.txt") (P_COPY))
  )
  (if (= (exists "ENV:Beam68/Aliases.txt" (noreq)) 0)
    ((set #to "ENV:Beam68") (set #src "Aliases.txt") (P_COPY))
  )
  (complete 85)

  ; -- Workbench startup entry
  (if #autostart
    (
      (if (= (exists #startup (noreq)) 0)
        (textfile (prompt #t_creating_startup) (help @textfile-help)
                  (dest #startup) (append ""))
      )
      (if (= (exists (cat #startup ".info") (noreq)) 0)
        ((set #to "SYS:WBStartup") (set #src "installer/Beam68Start.info") (P_COPY))
      )
      (tooltype
        (prompt #t_pointing_startup)
        (help @tooltype-help)
        (dest #startup)
        (setdefaulttool (tackon #dest "Beam68"))
      )
    )
    (
      (set #file #startup) (P_DELETE_FILE)
      (set #file (cat #startup ".info")) (P_DELETE_FILE)
    )
  )

  ; -- remember the location for later updates and uninstallation
  (textfile (prompt #t_recording) (help @textfile-help)
            (dest "ENVARC:Beam68/InstallDir") (append #dest))
  (textfile (prompt #t_recording) (help @textfile-help)
            (dest "ENV:Beam68/InstallDir") (append #dest))
  (complete 100)

  (if (askbool
        (prompt (cat (if #update #t_done_updated #t_done_installed) #dest #t_start_now))
        (help @askbool-help)
        (default 1)
        (choices #t_start #t_not_now))
    (run (cat "Run >NIL: \"" (tackon #dest "Beam68") "\""))
  )
  (exit #t_ready)
)

; --------------------------------------------------------------- uninstall

(procedure P_UNINSTALL
  (set #dest (if (= #existing "") #default-dest #existing))
  (set #dest
    (askdir
      (prompt #t_which_remove)
      (help @askdir-help)
      (default #dest)
    )
  )
  (if (<> (exists (tackon #dest "Beam68") (noreq)) 1)
    (abort (cat #dest #t_not_contain))
  )
  (if (= 0 (askbool
        (prompt (cat #t_remove_q #dest #t_remove_list))
        (help @askbool-help)
        (default 0)
        (choices #t_remove #t_cancel)))
    (exit #t_nothing_removed (quiet))
  )

  ; Prefer this archive's Beam68Ctl (it knows QUITWAIT); fall back to the
  ; installed one.
  (if (<> (exists "Beam68Ctl" (noreq)) 1)
    (set #ctl (tackon #dest "Beam68Ctl"))
  )
  (P_STOP_LAUNCHER)
  (complete 20)

  (working (cat #t_removing #dest))
  (run (cat "C:Delete \"" #dest "\" ALL QUIET FORCE"))
  (set #file (cat #dest ".info")) (P_DELETE_FILE)
  (set #file "SYS:Prefs/Beam68Prefs") (P_DELETE_FILE)
  (set #file "SYS:Prefs/Beam68Prefs.info") (P_DELETE_FILE)
  (set #file "LOCALE:Catalogs/deutsch/Beam68Prefs.catalog") (P_DELETE_FILE)
  (set #file "LOCALE:Catalogs/svenska/Beam68Prefs.catalog") (P_DELETE_FILE)
  (set #file "LOCALE:Catalogs/deutsch/Beam68Plugins.catalog") (P_DELETE_FILE)
  (set #file "LOCALE:Catalogs/svenska/Beam68Plugins.catalog") (P_DELETE_FILE)
  (set #file #startup) (P_DELETE_FILE)
  (set #file (cat #startup ".info")) (P_DELETE_FILE)
  (complete 70)

  (if (askbool
        (prompt #t_keep_q)
        (help @askbool-help)
        (default 1)
        (choices #t_keep #t_delete))
    (
      (set #file "ENVARC:Beam68/InstallDir") (P_DELETE_FILE)
      (set #file "ENV:Beam68/InstallDir") (P_DELETE_FILE)
    )
    (
      (run "C:Delete ENVARC:Beam68 ALL QUIET FORCE")
      (run "C:Delete ENV:Beam68 ALL QUIET FORCE")
    )
  )
  (complete 100)
  (exit #t_removed)
)

; -------------------------------------------------------------------- main

(set #existing (getenv "Beam68/InstallDir"))
(if (= #existing "")
  (if (= (exists (tackon #default-dest "Beam68") (noreq)) 1)
    (set #existing #default-dest)
  )
)
(if (<> #existing "")
  (if (<> (exists (tackon #existing "Beam68") (noreq)) 1)
    (set #existing "")
  )
)

(welcome #t_welcome)

(set #action
  (askchoice
    (prompt (if (= #existing "")
      #t_not_installed
      (cat #t_installed_in #existing #t_what_do)))
    (help #t_help_main @askchoice-help)
    (choices #t_choice_install #t_choice_uninstall)
    (default 0)
  )
)

(if (= #action 0)
  (P_INSTALL)
  (P_UNINSTALL)
)
