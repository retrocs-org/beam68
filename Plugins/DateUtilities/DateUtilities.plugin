VERSION=1
ID=org.beam68.dateutilities
PLUGIN_VERSION=0.1
MIN_BEAM68=0.1
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Date Utilities
TRIGGER=:
PREFIX=DATE:
COMMAND=PLUGINDIR:DateUtilities
DESCRIPTION=today, add:N, weekday:YYYY-MM-DD, or timestamp.
CATEGORY=Utilities
CAPABILITIES=READONLY
PREVIEW=YES
ICON=PROGDIR:Beam68
EXAMPLE=date:today
HELP=Date arithmetic, weekday lookup and AmigaDOS timestamps.
