# Beam68 external plugin protocol v1
VERSION=1
ID=org.beam68.calc
PLUGIN_VERSION=0.3
MIN_BEAM68=0.1
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Calculator
TRIGGER==
COMMAND=PLUGINDIR:Calc
DESCRIPTION=Offline arithmetic and unit conversion. No FPU needed.
CATEGORY=Utilities
CAPABILITIES=READONLY
ICON=PROGDIR:Beam68
EXAMPLE==12*(3+4)
HELP=Arithmetic and units: =1.5 MiB to KiB; =32 F to C. C/F/K, bytes, time, length, mass. ~ marks truncated results.
