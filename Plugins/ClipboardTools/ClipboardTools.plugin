VERSION=1
ID=org.beam68.clipboardtools
PLUGIN_VERSION=0.2
MIN_BEAM68=0.5
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Clipboard Tools
TRIGGER=&
PREFIX=CLIP:
COMMAND=PLUGINDIR:ClipboardTools
SETTINGS=ENVARC:Beam68/Plugins/ClipboardTools.cfg
SETTING=HISTORY_ENTRIES|History entries|CHOICE|8|1,4,8,12,16
SETTING=HISTORY_BYTES|Retained text bytes|CHOICE|2048|256,512,1024,2048
SETTING=EXPIRY_MINUTES|History expiry (minutes)|CHOICE|30|1,5,15,30,60,240
DESCRIPTION=Clipboard commands and optional bounded session history.
CATEGORY=Utilities
CAPABILITIES=CLIPBOARD,FILES
ICON=PROGDIR:Beam68
EXAMPLE=clip:show
HELP=history on records this session; off stops and clears; clear erases. history <text> searches. Select, then Enter to restore.
