VERSION=1
ID=org.beam68.musiclibrary
PLUGIN_VERSION=0.10
MIN_BEAM68=0.2
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Music Library
TRIGGER=;
PREFIX=MOD:
COMMAND=PLUGINDIR:MusicLibrary
SETTINGS=ENVARC:Beam68/Plugins/MusicLibrary.cfg
SETTING=DRAWER|Music drawer (blank uses index roots)|TEXT|
SETTING=PLAYER_COMMAND|Player command|TEXT|Run >NIL: HippoPlayer "{file}"
DESCRIPTION=Search music modules separately from the application index and send them to a player.
CATEGORY=Media
CAPABILITIES=FILES,SYSTEM
ICON=PROGDIR:Beam68
EXAMPLE=mod:enigma
HELP=Enter searches; choose a result, then Enter to play. Set music drawer and player command in Settings.
