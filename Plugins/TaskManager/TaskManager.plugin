VERSION=1
ID=org.beam68.taskmanager
PLUGIN_VERSION=0.1
MIN_BEAM68=0.1
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Task Manager
TRIGGER=^
PREFIX=TASK:
COMMAND=PLUGINDIR:TaskManager
DESCRIPTION=tasks lists processes; break:name:confirm sends Ctrl-C.
CATEGORY=System
CAPABILITIES=SYSTEM
ICON=PROGDIR:Beam68
EXAMPLE=task:tasks
HELP=Task signaling is exact-name only and requires confirm.
