VERSION=1
ID=org.beam68.clock
PLUGIN_VERSION=0.1
MIN_BEAM68=0.1
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Clock
TRIGGER=@
COMMAND=PLUGINDIR:Clock
DESCRIPTION=Press Enter for AmigaDOS local time.
SETTINGS=ENVARC:Beam68/Plugins/Clock.cfg
CATEGORY=Utilities
CAPABILITIES=READONLY
ICON=PROGDIR:Beam68
EXAMPLE=@
HELP=Displays local AmigaDOS date and time.
SETTING=SHOW_SECONDS|Show seconds|BOOL|NO
