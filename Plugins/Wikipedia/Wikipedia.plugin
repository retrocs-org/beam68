VERSION=1
ID=org.beam68.wikipedia
PLUGIN_VERSION=0.3
MIN_BEAM68=0.2
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Wikipedia
TRIGGER=\
PREFIX=WIKI:
COMMAND=PLUGINDIR:Wikipedia
SETTINGS=ENVARC:Beam68/Plugins/Wikipedia.cfg
SETTING=LANGUAGE|Wikipedia language|CHOICE|en|en,sv,de,da,fi,no,fr,es,it,nl,pt,pl
SETTING=CURL|HTTPS downloader|TEXT|C:curl
SETTING=OPENURL|OpenURL executable|TEXT|C:OpenURL
DESCRIPTION=Search Wikipedia and read article summaries in a native window.
CATEGORY=Internet
CAPABILITIES=FILES,SYSTEM
ICON=PROGDIR:Beam68
EXAMPLE=wiki:Amiga
HELP=Enter searches; choose an article, then Enter again for its summary. Requires curl with HTTPS support.
