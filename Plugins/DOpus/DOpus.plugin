VERSION=1
ID=org.beam68.dopus
PLUGIN_VERSION=0.4
MIN_BEAM68=0.2
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=DOpus
TRIGGER=}
PREFIX=DOPUS:
COMMAND=PLUGINDIR:DOpus
SETTINGS=ENVARC:Beam68/Plugins/DOpus.cfg
SETTING=PORT|ARexx port|TEXT|DOPUS.1
SETTING=OPEN_DRAWERS|Open drawers in Directory Opus|BOOL|NO
DESCRIPTION=Open drawers and reveal selected results in Directory Opus.
CATEGORY=System
CAPABILITIES=FILES,SYSTEM,AREXX
EXAMPLE=dopus:SYS:Prefs
HELP=Use dopus:<drawer>. Supports Directory Opus 5 and ScanDir fallback for Opus 4.
