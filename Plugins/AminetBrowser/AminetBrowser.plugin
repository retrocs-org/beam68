VERSION=1
ID=org.beam68.aminetbrowser
PLUGIN_VERSION=0.2
MIN_BEAM68=0.2
AUTHOR=Beam68 contributors
LICENSE=MIT
NAME=Aminet Browser
TRIGGER=]
PREFIX=AMINET:
COMMAND=PLUGINDIR:AminetBrowser
SETTINGS=ENVARC:Beam68/Plugins/AminetBrowser.cfg
SETTING=DOWNLOAD_DIR|Download drawer|TEXT|RAM:Beam68Downloads
DESCRIPTION=Search Aminet, read details/readmes, download archives and open them for installation.
CATEGORY=Internet
CAPABILITIES=FILES,SYSTEM
ICON=PROGDIR:Beam68
EXAMPLE=aminet:search tracker
HELP=Select a result then press Enter for details. get and install ask before downloading. Requires a TCP/IP stack.
GUIDE=PLUGINDIR:AminetBrowser.guide
