# macOS cross-build for classic AmigaOS using vbcc and the NDK 3.2 headers.
VC ?= vc +aos68k -notmpfile
# -O2: verify with a native runtime check; fall back to -O if vbcc misbehaves.
CFLAGS ?= -O2 -cpu=68000
INC = -Iinclude -Isdk/include
COMMON = src/config.c src/control.c
PLUGIN_COMMON = src/protocol.c src/plugin_common.c src/plugin_locale.c src/beam68plugins_strings.c sdk/src/beam68plugin.c
NEW_PLUGINS = Plugins/AmiHASS/AmiHASS Plugins/Wikipedia/Wikipedia Plugins/WHDLoad/WHDLoad Plugins/DOpus/DOpus Plugins/MusicLibrary/MusicLibrary Plugins/FileFinder/FileFinder Plugins/SystemCommands/SystemCommands Plugins/DosTools/DosTools Plugins/TaskManager/TaskManager Plugins/ClipboardTools/ClipboardTools Plugins/DateUtilities/DateUtilities Plugins/WindowSwitcher/WindowSwitcher Plugins/DeveloperTools/DeveloperTools Plugins/ARexxRunner/ARexxRunner Plugins/MusicControls/MusicControls Plugins/AminetBrowser/AminetBrowser

.PHONY: all clean

all: Beam68 Beam68Prefs Beam68Ctl CreateIcons Plugins/Calc/Calc Plugins/Clock/Clock Plugins/Memory/Memory $(NEW_PLUGINS)

Beam68: src/main.c src/rexx_sequence.c src/matcher.c src/search_rank.c src/search_scope.c src/calc_engine.c src/history.c src/query_history.c src/plugin_health.c src/favorites.c src/aliases.c src/index_cache.c src/actions.c src/plugin_job.c src/launcher_ui.c src/appearance.c src/recovery.c src/rexx_commands.c src/plugin_diagnostics.c src/scan_status.c src/completion.c src/item_index.c src/dos_compat.c src/wb_launch.c src/stack_guard.c src/startup_error.c src/icon_info.c src/whdload.c src/clip.c src/hidden.c src/sources.c src/locale_support.c src/beam68_strings.c $(COMMON)
	$(VC) $(CFLAGS) $(INC) -o $@ src/main.c src/rexx_sequence.c src/matcher.c src/search_rank.c src/search_scope.c src/calc_engine.c src/history.c src/query_history.c src/plugin_health.c src/favorites.c src/aliases.c src/index_cache.c src/actions.c src/plugin_job.c src/launcher_ui.c src/appearance.c src/recovery.c src/rexx_commands.c src/plugin_diagnostics.c src/scan_status.c src/completion.c src/item_index.c src/dos_compat.c src/wb_launch.c src/stack_guard.c src/startup_error.c src/icon_info.c src/whdload.c src/clip.c src/hidden.c src/sources.c src/locale_support.c src/beam68_strings.c $(COMMON)

Beam68Prefs: src/prefs.c src/launcher_ui.c src/hotkey_capture.c src/plugin_catalog.c src/plugin_diagnostics.c src/plugin_health.c src/favorites.c src/aliases.c src/wb_drop.c src/appearance.c src/theme_file.c src/dos_compat.c src/stack_guard.c src/startup_error.c src/plugin_package.c src/plugin_install.c src/preset.c src/catalogue.c src/catalogue_window.c src/beam68prefs_strings.c $(COMMON) Plugins/AmiHASS/client.c
	$(VC) $(CFLAGS) $(INC) -o $@ src/prefs.c src/launcher_ui.c src/hotkey_capture.c src/plugin_catalog.c src/plugin_diagnostics.c src/plugin_health.c src/favorites.c src/aliases.c src/wb_drop.c src/appearance.c src/theme_file.c src/dos_compat.c src/stack_guard.c src/startup_error.c src/plugin_package.c src/plugin_install.c src/preset.c src/catalogue.c src/catalogue_window.c src/beam68prefs_strings.c $(COMMON) Plugins/AmiHASS/client.c

Beam68Ctl: src/ctl.c src/control.c src/config.c src/appearance.c
	$(VC) $(CFLAGS) $(INC) -o $@ src/ctl.c src/control.c src/config.c src/appearance.c src/locale_support.c src/beam68_strings.c

CreateIcons: scripts/create_icons.c
	$(VC) $(CFLAGS) $(INC) -o $@ scripts/create_icons.c

Plugins/Calc/Calc: Plugins/Calc/Calc.c src/calc_engine.c $(PLUGIN_COMMON) Plugins/Calc/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/Calc/Calc.c src/calc_engine.c $(PLUGIN_COMMON) Plugins/Calc/version.c

Plugins/Clock/Clock: Plugins/Clock/Clock.c $(PLUGIN_COMMON) Plugins/Clock/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/Clock/Clock.c $(PLUGIN_COMMON) Plugins/Clock/version.c

Plugins/Memory/Memory: Plugins/Memory/Memory.c $(PLUGIN_COMMON) Plugins/Memory/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/Memory/Memory.c $(PLUGIN_COMMON) Plugins/Memory/version.c

Plugins/FileFinder/FileFinder: Plugins/FileFinder/FileFinder.c src/plugin_walk.c src/config.c src/appearance.c $(PLUGIN_COMMON) Plugins/FileFinder/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/FileFinder/FileFinder.c src/plugin_walk.c src/config.c src/appearance.c $(PLUGIN_COMMON) Plugins/FileFinder/version.c

Plugins/SystemCommands/SystemCommands: Plugins/SystemCommands/SystemCommands.c src/dos_compat.c $(PLUGIN_COMMON) Plugins/SystemCommands/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/SystemCommands/SystemCommands.c src/dos_compat.c $(PLUGIN_COMMON) Plugins/SystemCommands/version.c

Plugins/DosTools/DosTools: Plugins/DosTools/DosTools.c $(PLUGIN_COMMON) Plugins/DosTools/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/DosTools/DosTools.c $(PLUGIN_COMMON) Plugins/DosTools/version.c

Plugins/TaskManager/TaskManager: Plugins/TaskManager/TaskManager.c $(PLUGIN_COMMON) Plugins/TaskManager/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/TaskManager/TaskManager.c $(PLUGIN_COMMON) Plugins/TaskManager/version.c

Plugins/ClipboardTools/ClipboardTools: Plugins/ClipboardTools/ClipboardTools.c $(PLUGIN_COMMON) Plugins/ClipboardTools/version.c src/clipboard_history.c src/stack_guard.c include/clipboard_history.h
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/ClipboardTools/ClipboardTools.c $(PLUGIN_COMMON) Plugins/ClipboardTools/version.c src/clipboard_history.c src/stack_guard.c

Plugins/DateUtilities/DateUtilities: Plugins/DateUtilities/DateUtilities.c $(PLUGIN_COMMON) Plugins/DateUtilities/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/DateUtilities/DateUtilities.c $(PLUGIN_COMMON) Plugins/DateUtilities/version.c

Plugins/WindowSwitcher/WindowSwitcher: Plugins/WindowSwitcher/WindowSwitcher.c $(PLUGIN_COMMON) Plugins/WindowSwitcher/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/WindowSwitcher/WindowSwitcher.c $(PLUGIN_COMMON) Plugins/WindowSwitcher/version.c

Plugins/DeveloperTools/DeveloperTools: Plugins/DeveloperTools/DeveloperTools.c $(PLUGIN_COMMON) Plugins/DeveloperTools/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/DeveloperTools/DeveloperTools.c $(PLUGIN_COMMON) Plugins/DeveloperTools/version.c

Plugins/ARexxRunner/ARexxRunner: Plugins/ARexxRunner/ARexxRunner.c src/dos_compat.c $(PLUGIN_COMMON) Plugins/ARexxRunner/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/ARexxRunner/ARexxRunner.c src/dos_compat.c $(PLUGIN_COMMON) Plugins/ARexxRunner/version.c

Plugins/MusicControls/MusicControls: Plugins/MusicControls/MusicControls.c src/music_control.c $(PLUGIN_COMMON) Plugins/MusicControls/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/MusicControls/MusicControls.c src/music_control.c $(PLUGIN_COMMON) Plugins/MusicControls/version.c

clean:
	rm -f Beam68 Beam68Prefs Beam68Ctl CreateIcons Plugins/Calc/Calc Plugins/Clock/Clock Plugins/Memory/Memory $(NEW_PLUGINS)
	find src Plugins scripts -type f -name '*.o' -delete

# Header/catalog changes must invalidate every affected executable.
Beam68 Beam68Prefs Beam68Ctl Plugins/Calc/Calc Plugins/Clock/Clock Plugins/Memory/Memory $(NEW_PLUGINS): $(wildcard include/*.h sdk/include/*.h)

Plugins/AminetBrowser/AminetBrowser: Plugins/AminetBrowser/AminetBrowser.c src/control.c src/aminet.c src/aminet_http.c src/stack_guard.c $(PLUGIN_COMMON) Plugins/AminetBrowser/version.c Plugins/AminetBrowser/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/AminetBrowser/AminetBrowser.c src/control.c src/aminet.c src/aminet_http.c src/stack_guard.c $(PLUGIN_COMMON) Plugins/AminetBrowser/version.c Plugins/AminetBrowser/version.c

Plugins/MusicLibrary/MusicLibrary: Plugins/MusicLibrary/MusicLibrary.c src/plugin_walk.c src/config.c src/appearance.c src/sources.c $(PLUGIN_COMMON) Plugins/MusicLibrary/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/MusicLibrary/MusicLibrary.c src/plugin_walk.c src/config.c src/appearance.c src/sources.c $(PLUGIN_COMMON) Plugins/MusicLibrary/version.c

Plugins/WHDLoad/WHDLoad: Plugins/WHDLoad/WHDLoad.c src/icon_info.c src/plugin_walk.c src/config.c src/appearance.c $(PLUGIN_COMMON) Plugins/WHDLoad/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/WHDLoad/WHDLoad.c src/icon_info.c src/plugin_walk.c src/config.c src/appearance.c $(PLUGIN_COMMON) Plugins/WHDLoad/version.c

Plugins/DOpus/DOpus: Plugins/DOpus/DOpus.c src/config.c src/appearance.c src/rexx_sequence.c $(PLUGIN_COMMON) Plugins/DOpus/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/DOpus/DOpus.c src/config.c src/appearance.c src/rexx_sequence.c $(PLUGIN_COMMON) Plugins/DOpus/version.c

Plugins/Wikipedia/Wikipedia: Plugins/Wikipedia/Wikipedia.c src/wikipedia.c src/launcher_ui.c src/control.c src/stack_guard.c $(PLUGIN_COMMON) Plugins/Wikipedia/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/Wikipedia/Wikipedia.c src/wikipedia.c src/launcher_ui.c src/control.c src/stack_guard.c $(PLUGIN_COMMON) Plugins/Wikipedia/version.c

Plugins/AmiHASS/AmiHASS: Plugins/AmiHASS/AmiHASS.c Plugins/AmiHASS/client.c $(PLUGIN_COMMON) Plugins/AmiHASS/version.c
	$(VC) $(CFLAGS) $(INC) -o $@ Plugins/AmiHASS/AmiHASS.c Plugins/AmiHASS/client.c $(PLUGIN_COMMON) Plugins/AmiHASS/version.c
