{
  "plugins": [
    {
      "NAME": "Aminet Browser",
      "DESCRIPTION": "Search Aminet, read package details and readmes, then confirm downloads. Open downloaded archives with your archive handler and follow the included installer.",
      "PREFIX": "AMINET:",
      "TRIGGER": "]",
      "EXAMPLE": "aminet:search tracker",
      "path": "Plugins/AminetBrowser",
      "introduced": "0.2",
      "default_enabled": false
    },
    {
      "NAME": "ARexx Runner",
      "DESCRIPTION": "Run configured ARexx macros by name; query text cannot supply arbitrary script paths.",
      "PREFIX": "REXX:",
      "TRIGGER": "%",
      "EXAMPLE": "rexx:list",
      "path": "Plugins/ARexxRunner",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Assigns and Volumes",
      "DESCRIPTION": "volumes, assigns, diskfree:path, or open:path.",
      "PREFIX": "DOS:",
      "TRIGGER": "#",
      "EXAMPLE": "open:RAM:",
      "path": "Plugins/DosTools",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Calculator",
      "DESCRIPTION": "Type = 2*(5+3), then press Enter. Integer, no FPU needed.",
      "PREFIX": "",
      "TRIGGER": "=",
      "EXAMPLE": "=12*(3+4)",
      "path": "Plugins/Calc",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Clipboard Tools",
      "DESCRIPTION": "show, set:text, clear, upper, lower, or save:path.",
      "PREFIX": "CLIP:",
      "TRIGGER": "&",
      "EXAMPLE": "clip:show",
      "path": "Plugins/ClipboardTools",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Clock",
      "DESCRIPTION": "Press Enter for AmigaDOS local time.",
      "PREFIX": "",
      "TRIGGER": "@",
      "EXAMPLE": "@",
      "path": "Plugins/Clock",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Date Utilities",
      "DESCRIPTION": "today, add:N, weekday:YYYY-MM-DD, or timestamp.",
      "PREFIX": "DATE:",
      "TRIGGER": ":",
      "EXAMPLE": "date:today",
      "path": "Plugins/DateUtilities",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Developer Tools",
      "DESCRIPTION": "hex:N, dec:$FF, ascii:N, mask:0,3,7, or prot:RWED.",
      "PREFIX": "DEV:",
      "TRIGGER": "$",
      "EXAMPLE": "dev:hex:255",
      "path": "Plugins/DeveloperTools",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "File Finder",
      "DESCRIPTION": "find:<name> searches configured drawers for files and folders.",
      "PREFIX": "FIND:",
      "TRIGGER": "/",
      "EXAMPLE": "find:screenmode",
      "path": "Plugins/FileFinder",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Memory",
      "DESCRIPTION": "Press Enter to display free Chip and Fast RAM.",
      "PREFIX": "",
      "TRIGGER": "?",
      "EXAMPLE": "?",
      "path": "Plugins/Memory",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Music Controls",
      "DESCRIPTION": "Control HippoPlayer, AmigaAMP or EaglePlayer 2 through their documented ARexx ports.",
      "PREFIX": "MUSIC:",
      "TRIGGER": "|",
      "EXAMPLE": "music:status",
      "path": "Plugins/MusicControls",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "System Commands",
      "DESCRIPTION": "avail, version, flush, reboot confirm, or shutdown confirm.",
      "PREFIX": "SYSTEM:",
      "TRIGGER": "!",
      "EXAMPLE": "system:version",
      "path": "Plugins/SystemCommands",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Task Manager",
      "DESCRIPTION": "tasks lists processes; break:name:confirm sends Ctrl-C.",
      "PREFIX": "TASK:",
      "TRIGGER": "^",
      "EXAMPLE": "task:tasks",
      "path": "Plugins/TaskManager",
      "introduced": "0.1",
      "default_enabled": true
    },
    {
      "NAME": "Workbench Windows",
      "DESCRIPTION": "windows lists titles; window:name or screen:name brings one forward.",
      "PREFIX": "WINDOW:",
      "TRIGGER": "~",
      "EXAMPLE": "window:windows",
      "path": "Plugins/WindowSwitcher",
      "introduced": "0.1",
      "default_enabled": true
    }
  ],
  "themes": [
    {
      "name": "Amber",
      "description": "Warm amber on near-black, like an old terminal",
      "colors": [
        "FFB000",
        "6B4A00",
        "FFB000",
        "1A1200",
        "140E00"
      ],
      "path": "themes/Amber.theme"
    },
    {
      "name": "GreenScreen",
      "description": "Phosphor green on black",
      "colors": [
        "33FF66",
        "1F6B33",
        "33FF66",
        "001A08",
        "000F05"
      ],
      "path": "themes/GreenScreen.theme"
    },
    {
      "name": "MagicGrey",
      "description": "MagicWB-style greys with a blue selection",
      "colors": [
        "000000",
        "7B7B7B",
        "6B8CB5",
        "FFFFFF",
        "AAAAAA"
      ],
      "path": "themes/MagicGrey.theme"
    },
    {
      "name": "Paper",
      "description": "Dark ink on light paper",
      "colors": [
        "202020",
        "8A8A8A",
        "3A6EA5",
        "FFFFFF",
        "F2EFE6"
      ],
      "path": "themes/Paper.theme"
    }
  ]
}
